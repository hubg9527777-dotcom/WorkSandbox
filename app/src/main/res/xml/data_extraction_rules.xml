<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+：显式禁止云备份和设备到设备迁移提取应用私有数据。 -->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
